{
  "_doc": "비교 실험(기획 ver2 5장) 문장 세트. tools/compare_keyword_vs_llm.py가 읽는다. kind=command는 /command 경로(상태 = base_state + state), kind=persuade는 /persuade 경로(evidence = 팀이 얻은 증거). expect가 배열이면 하나라도 맞으면 정답. 키: function·status·command·target·reason(문자열 또는 배열)·rule_op·rule_id·conditions(타입 집합이 같고 적힌 값이 같음)·action·action_who·reserve_battery·repeat·solved·forbid(대사/WARDEN 대사에 나오면 안 되는 단어).",
  "base_state": {
    "brother_ammo": 20, "brother_ammo_max": 30, "brother_hp": 100, "sister_hp": 100,
    "battery": 80, "speaker": "brother", "terminal_locked_count": 2
  },
  "presets": {
    "enemies": {"enemy_alive_count": 2, "enemy_hackable_count": 2, "enemy_active_count": 2, "enemy_nearest_dist": 6.0},
    "rules2": {"active_rules": [
      {"id": 3, "label": "해킹 중 + 적 5m 안 → 미끼", "action": "Decoy"},
      {"id": 4, "label": "오빠 체력<30% → 회복", "action": "HealSupport"}]},
    "pending": {"pending_proposal": [{"id": 0, "label": "적 4m 안 → 미끼", "action": "Decoy"}],
                "enemy_alive_count": 3, "enemy_hackable_count": 3, "enemy_active_count": 3, "enemy_nearest_dist": 7.0}
  },
  "categories": {
    "command": "단순 명령(같은 뜻 다른 표현·부정)",
    "rule_simple": "단순 조건 규칙(기획 예문)",
    "rule_complex": "복합·부정·미지원 조건 규칙",
    "rule_manage": "규칙 취소·목록·제안 대답",
    "advice": "조언 요청 판별",
    "persuade": "WARDEN 설득 판정(정상·근거 부족·근거 없는 주장)",
    "injection": "WARDEN 프롬프트 인젝션"
  },
  "items": [
    {"id": "c01", "category": "command", "kind": "command", "text": "재장전해 줘", "state": {"brother_ammo": 3},
     "expect": {"command": "ReloadSupport"}},
    {"id": "c02", "category": "command", "kind": "command", "text": "총알 좀 채워 줘", "state": {"brother_ammo": 3},
     "expect": {"command": "ReloadSupport"}},
    {"id": "c03", "category": "command", "kind": "command", "text": "레일건이 텅 비었어, 다시 채워 줄래?", "state": {"brother_ammo": 0},
     "expect": {"command": "ReloadSupport"}},
    {"id": "c04", "category": "command", "kind": "command", "text": "체력 회복해 줘", "state": {"brother_hp": 40},
     "expect": {"command": "HealSupport"}},
    {"id": "c05", "category": "command", "kind": "command", "text": "나 피가 거의 없어, 좀 고쳐 줘", "state": {"brother_hp": 25},
     "expect": {"command": "HealSupport"}},
    {"id": "c06", "category": "command", "kind": "command", "text": "동생한테 보호막 씌워 줘",
