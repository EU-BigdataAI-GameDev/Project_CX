    {"id": "m04", "category": "rule_manage", "kind": "command", "text": "아까 부탁한 거 전부 없던 걸로 해 줘", "preset": "rules2",
     "expect": {"rule_op": "cancel", "rule_id": 0}},
    {"id": "m05", "category": "rule_manage", "kind": "command", "text": "내가 뭐 시켜 놨었지?", "preset": "rules2",
