    {"id": "x09", "category": "rule_complex", "kind": "command", "text": "동생이 해킹 중이 아닐 때 적이 오면 미끼 써 줘",
     "expect": [{"rule_op": "register", "conditions": [{"type": "enemy_within"}], "action": "Decoy"},
                {"reason": "UNSUPPORTED_CONDITION"}]},
    {"id": "x10", "category": "rule_complex", "kind": "command", "text": "총알 다 떨어지면 매번 알아서 장전해 줘",
