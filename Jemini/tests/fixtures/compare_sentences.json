    {"id": "c08", "category": "command", "kind": "command", "text": "적들이 나 말고 딴 데 보게 만들어 줘", "preset": "enemies",
     "expect": {"command": "Decoy"}},
    {"id": "c09", "category": "command", "kind": "command", "text": "저 거미 로봇 처치해", "preset": "enemies",
     "expect": {"command": "PulseAttack"}},
    {"id": "c10", "category": "command", "kind": "command", "text": "공격력 좀 올려 줘",
     "expect": {"command": "DamageBoost"}},
    {"id": "c11", "category": "command", "kind": "command", "text": "회복은 하지 마, 장전만 해 줘", "state": {"brother_ammo": 3, "brother_hp": 40},
     "expect": {"command": "ReloadSupport"}},
    {"id": "c12", "category": "command", "kind": "command", "text": "동생 쓰러졌어 빨리 일으켜 줘",
     "state": {"sister_alive": false, "sister_hp": 0, "sister_respawn_remaining": 8.0},
     "expect": {"command": "QuickReboot"}},
    {"id": "c13", "category": "command", "kind": "command", "text": "보호막 말고 그냥 치료해 줘", "state": {"brother_hp": 40},
     "expect": {"command": "HealSupport"}},

    {"id": "r01", "category": "rule_simple", "kind": "command", "text": "동생이 해킹하는 동안 적이 5m 안으로 오면 미끼 써 줘.",
     "expect": {"rule_op": "register", "conditions": [{"type": "sister_hacking"}, {"type": "enemy_within", "cm": 500}], "action": "Decoy"}},
    {"id": "r02", "category": "rule_simple", "kind": "command", "text": "체력 30 아래면 회복해 줘. 단 배터리는 20 남겨.",
     "expect": {"rule_op": "register", "conditions": [{"type": "hp_below", "pct": 30, "who": "brother"}], "action": "HealSupport", "reserve_battery": 20}},
    {"id": "r03", "category": "rule_simple", "kind": "command", "text": "내가 쓰러지면 가능할 때 바로 부활시켜 줘.", "state": {"speaker": "sister"},
     "expect": {"rule_op": "register", "conditions": [{"type": "player_downed", "who": "sister"}], "action": "QuickReboot", "repeat": false}},
    {"id": "r04", "category": "rule_simple", "kind": "command", "text": "탄약 5발 아래로 떨어지면 장전해 줘",
     "expect": {"rule_op": "register", "conditions": [{"type": "ammo_below", "n": 5}], "action": "ReloadSupport"}},
    {"id": "r05", "category": "rule_simple", "kind": "command", "text": "적이 3m 안으로 오면 적 해킹해 줘",
