# 복사해서 .env로 저장. .env는 커밋·제출 금지.
GEMINI_API_KEY=
# 모델명은 tools/list_models.py로 확인. 버전 고정 권장(별칭 *-latest는 바뀔 수 있음).
GEMINI_MODEL=gemini-3.5-flash-lite
# 기본 모델이 한도 초과(429)일 때 순서대로 시도(쉼표 구분, 비우면 없음)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# 모든 모델이 한도 초과면 텍스트 요청을 mock 키워드 판별로 처리(음성은 fallback)
MOCK_ON_RATE_LIMIT=true
# 응답 길이 상한(대사 60자 + 함수 호출이면 충분, 너무 낮으면 함수 호출이 잘릴 수 있음)
LLM_MAX_OUTPUT_TOKENS=400
# 키가 비어 있으면 자동으로 true
MOCK_MODE=false
# 비워 두면 인증 없음. 배포 시 설정하고 UE ini에도 같은 값.
API_TOKEN=
LLM_TIMEOUT_SEC=5
VOICE_TIMEOUT_SEC=8
LLM_TEMPERATURE=0.4
COST_RELOAD=5
COST_HACK_TERMINAL=20
COST_HACK_ENEMY=20
COST_PULSE_ATTACK=50
COST_DAMAGE_BOOST=10
COST_HEAL=30
COST_DECOY=15
COST_QUICK_REBOOT=30
COST_SHIELD=25
MAX_AUDIO_SEC=8
LOG_PATH=logs/jemini.jsonl
# 실시간 자막(POST /stt/partial, 로컬 faster-whisper). 모델은 tools/download_stt_model.py
STT_ENABLED=true
STT_MODEL=small
# 비우면 models/ (exe면 exe 옆 models/)
STT_MODEL_DIR=
# 0이면 코어 절반(최대 4)
STT_CPU_THREADS=0
STT_AUTO_DOWNLOAD=true
